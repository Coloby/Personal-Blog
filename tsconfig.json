{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@payload-config": [ "src/payload/payload.config.ts" ],
      "react": [ "./node_modules/@types/react" ],
      "@/*": [ "./src/*" ],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "dist/types/**/*.ts",
    "src/app/(frontend)/page.jsx",
    "src/app/(mainHeaderRoutes)/blog/[slug]/page.jsx",
    "src/app/(mainHeaderRoutes)/blog/page.jsx",
    "src/features/mdx/mdxManager.js",
    "src/components/primitives/shadcn-ui/accordion.tsx",
    "src/app/(frontend)/sitemap.js",
    "src/app/(frontend)/robots.ts",
    "src/components/layout/header/Header.jsx",
    "src/components/layout/Footer.jsx", 
    "src/utils/formatToSlug.js"  
, "src/payload/features/accessControl/utils/authOR.js", "src/payload/features/accessControl/utils/mixstuff.js", "src/payload/collections/content/posts/hooks/revalidatePost.js", "src/payload/collections/content/posts/hooks/revalidatePost.js", "src/payload/utils/queryCMS/findCMSDocBySlug.js", "src/app/(frontend)/(1headerRoutes)/blog/page.jsx", "src/app/(frontend)/(1headerRoutes)/blog/[slug]/page.jsx", "src/components/logic/settings/SettingsBtn.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}
